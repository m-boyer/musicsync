# Postgres connection used for sync state.
DATABASE_URL=postgres://musicsync:musicsync@localhost:5432/musicsync

# Cookie header from a request to music.youtube.com while signed in.
YT_COOKIE=
# Value of the media-user-token cookie on music.apple.com. Expires after about 180 days.
APPLE_MEDIA_USER_TOKEN=
# Storefront of your Apple Music account, such as ar or us.
APPLE_STOREFRONT=us
# Optional. Use the combination that `npm run probe` reports as working.
APPLE_BASE_URL=
APPLE_USER_TOKEN_HEADER=Music-User-Token

# dry-run: log what would happen. add-only: add on both sides. full: add and delete.
SYNC_MODE=dry-run
SYNC_INTERVAL_SECONDS=300
MAX_OPS_PER_CYCLE=25
MAX_DELETES_PER_CYCLE=5
ADD_GRACE_MINUTES=30
MATCH_THRESHOLD=0.8

SENTRY_DSN=
PORT=3000
