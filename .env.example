# Postgres for the sync state, settings, encrypted credentials and sessions.
DATABASE_URL=postgres://musicsync:musicsync@localhost:5432/musicsync

# openssl rand -base64 32. Encrypts the saved credentials: if it changes, save them again.
APP_ENCRYPTION_KEY=
# openssl rand -base64 32. Signs sessions.
BETTER_AUTH_SECRET=
# The URL you open in the browser.
BETTER_AUTH_URL=http://localhost:3000

# The only account that can sign in.
ADMIN_EMAIL=you@example.com
# Creates that account the first time the app starts. At least 12 characters.
INITIAL_ADMIN_PASSWORD=

# Optional.
SENTRY_DSN=
LOG_LEVEL=info
