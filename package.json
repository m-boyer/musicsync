{
  "name": "musicsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db-migrations": "node dist/db/migrate.js",
    "probe": "node dist/probe.js",
    "probe:dev": "tsx --env-file=.env src/probe.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/node": "^11.11.0",
    "@syncfm/applemusic-api": "git+https://github.com/MatiasBoyer/applemusic-api.git#v0.1.0",
    "pg": "^8.23.1",
    "youtubei.js": "18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
